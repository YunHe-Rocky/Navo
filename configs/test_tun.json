{
  "log": {
    "level": "info",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "type": "tls",
        "tag": "secure-dns",
        "server": "1.1.1.1",
        "server_port": 853,
        "detour": "direct"
      }
    ],
    "rules": [
      {
        "inbound": ["tun-in"],
        "action": "route",
        "server": "secure-dns"
      }
    ],
    "final": "secure-dns",
    "strategy": "prefer_ipv4"
  },
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "interface_name": "Navo",
      "address": ["172.19.0.1/30"],
      "mtu": 1500,
      "auto_route": false,
      "strict_route": false,
      "stack": "mixed"
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct"
    }
  ],
  "route": {
    "auto_detect_interface": true,
    "rules": [
      {
        "protocol": "dns",
        "action": "hijack-dns"
      }
    ],
    "final": "direct"
  }
}
