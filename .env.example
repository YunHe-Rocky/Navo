# Copy this file to .env. Never commit real credentials.
NAVO_MYSQL_ENABLED=false
NAVO_MYSQL_REQUIRED=false
NAVO_MYSQL_HOST=mysql.example.com
NAVO_MYSQL_PORT=3306
NAVO_MYSQL_DATABASE=navo
NAVO_MYSQL_USER=navo_app
NAVO_MYSQL_PASSWORD=
NAVO_MYSQL_TLS_MODE=verify_identity
NAVO_MYSQL_CA_FILE=
NAVO_MYSQL_CONNECT_TIMEOUT=5s
NAVO_MYSQL_READ_TIMEOUT=10s
NAVO_MYSQL_WRITE_TIMEOUT=10s
NAVO_MYSQL_QUERY_TIMEOUT=10s
NAVO_MYSQL_MAX_OPEN_CONNS=10
NAVO_MYSQL_MAX_IDLE_CONNS=10
NAVO_MYSQL_CONN_MAX_LIFETIME=3m
NAVO_MYSQL_CONN_MAX_IDLE_TIME=1m

NAVO_AI_BASE_URL=
NAVO_AI_API_KEY=
NAVO_AI_MODEL=deepseek-v4-pro
